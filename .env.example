# SporMatch ortam değişkenleri.
# Bu dosyayı ".env" olarak kopyalayın ve gerçek değerleri girin.
# EXPO_PUBLIC_ önekli değişkenler istemci koduna gömülür (anon key güvenlidir; RLS korur).

EXPO_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Google Maps (Faz 4'te eklenecek — Android/iOS Maps SDK anahtarı)
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
